# ====================================================================
# Node / Dependency Modules
# ====================================================================
# This catches node_modules at the root, in Backend, frontend, and vite-project
**/node_modules/
**/.bin/

# ====================================================================
# Build & Local Development Outputs
# ====================================================================
# Vite / Frontend build caches and outputs
**/dist/
**/.vite/
**/.vite-temp/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ====================================================================
# Environment & Secret Files (CRITICAL)
# ====================================================================
# Never commit your database URI, API keys, or JWT secrets to GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
Backend/.env

# ====================================================================
# Project Specific & Temp Storage
# ====================================================================
# Ignores files uploaded temporarily to your Backend temp folder
Backend/Public/temp/*
# Keeps the temp folder structure intact on Git, but ignores files inside it
!Backend/Public/temp/.gitkeep

# Coverage reports (from package testing tools like kareem's nyc/lcov)
**/coverage/
**/.nyc_output/

# ====================================================================
# OS & IDE Specific Files
# ====================================================================
.DS_Store
Thmubs.db
.vscode/
.idea/